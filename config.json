{
  "N_H": 200,
  "N_F": 2,
  "N_B": 1,
  "interest_rate": 0.001,
  "loan_repayment_rate": 0.01,
  "loan_trigger_lookahead_ticks": 10,
  "loan_amount_multiplier": 2.0,
  "wage_rate": 5.0,
  "competitive_wage_increase_rate": 0.02,
  "job_switching_wage_threshold": 1.01,
  "unemployment_threshold_for_cuts": 0.10,
  "unemployment_threshold_for_increases": 0.05,
  "wage_cut_rate": 0.01,
  "labor_market_pressure_ratio_high": 1.0,
  "labor_market_pressure_ratio_low": 0.5,
  "p": 2.0,
  "price_adjustment_rate": 0.01,
  "profit_crisis_threshold": 5,
  "crisis_price_cut_rate": 0.25,
  "ambition_threshold": 100,
  "expansion_budget_rate": 0.02,
  "sales_history_ticks": 10,
  "inventory_upper_threshold_factor": 2.0,
  "inventory_lower_threshold_factor": 0.5,
  "workforce_adjustment_rate": 0.1,
  "min_target_workers": 1,
  "household_size": 4,
  "food_per_person": 1,
  "production_per_worker": 5,
  "raw_material_cost_per_unit": 0.5,
  "target_inventory_production_ticks_factor": 4,
  "firm_initial_capital": 5000,
  "M0": 40000,
  "seed": 42,
  "ticks_per_second": 5,
  "enable_proximity_choice": true,
  "shopping_firms_to_consider": 3,
  "firm_layoff_capital_threshold_factor": 2.0,
  "firm_hiring_revenue_threshold_factor": 1.5,
  "dividend_payout_rate": 0.01,
  "logging": {
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
      "detailed": {
        "format": "%(asctime)s - %(levelname)-8s - %(name)-15s - Tick:%(tick)-5d - %(message)s"
      }
    },
    "handlers": {
      "console": {
        "class": "logging.StreamHandler",
        "level": "INFO",
        "formatter": "detailed",
        "stream": "ext://sys.stdout"
      },
      "file": {
        "class": "logging.handlers.RotatingFileHandler",
        "level": "DEBUG",
        "formatter": "detailed",
        "filename": "placeholder.log",
        "maxBytes": 10485760,
        "backupCount": 5,
        "encoding": "utf8"
      }
    },
    "root": {
      "level": "DEBUG",
      "handlers": [
        "console",
        "file"
      ]
    }
  }
}