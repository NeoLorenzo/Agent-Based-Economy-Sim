{
  "N_H": 200,
  "N_F": 5,
  "wage_rate": 5.0,
  "enable_dynamic_wages": true,
  "wage_adjustment_sensitivity": 0.1,
  "target_unemployment_rate": 0.05,
  "wage_adjustment_tick_interval": 20,
  "p": 2.0,
  "price_adjustment_rate": 0.01,
  "inventory_upper_threshold_factor": 2.0,
  "inventory_lower_threshold_factor": 0.5,
  "household_size": 4,
  "food_per_person": 1,
  "firm_production_per_tick": 100,
  "wholesale_price": 0.5,
  "target_inventory_level_factor": 2.0,
  "firm_initial_capital": 5000,
  "M0": 40000,
  "seed": 42,
  "ticks_per_second": 5,
  "enable_proximity_choice": true,
  "shopping_firms_to_consider": 3,
  "firm_layoff_capital_threshold_factor": 2.0,
  "firm_hiring_revenue_threshold_factor": 1.5,
  "logging": {
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
      "detailed": {
        "format": "%(asctime)s - %(levelname)-8s - %(name)-15s - Tick:%(tick)-5d - %(message)s"
      }
    },
    "handlers": {
      "console": {
        "class": "logging.StreamHandler",
        "level": "INFO",
        "formatter": "detailed",
        "stream": "ext://sys.stdout"
      },
      "file": {
        "class": "logging.handlers.RotatingFileHandler",
        "level": "DEBUG",
        "formatter": "detailed",
        "filename": "placeholder.log",
        "maxBytes": 10485760,
        "backupCount": 5,
        "encoding": "utf8"
      }
    },
    "root": {
      "level": "DEBUG",
      "handlers": [
        "console",
        "file"
      ]
    }
  }
}